---
import '../styles/global.css';
import Navbar from '../components/Navbar.astro';

interface Props {
	title?: string;
    description?: string;
}

const { title = "Gauransh Kumar", description = "Personal website of Gauransh Kumar" } = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="description" content={description} />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
	</head>
	<body class="bg-background text-foreground selection:bg-accent/20 selection:text-accent">
        <div class="w-full px-6 md:px-12 max-w-[1400px] mx-auto">
            <Navbar />
        </div>

        <div class="mx-auto max-w-[1100px] px-6 md:px-12 pb-16">
            
            <div class="grid grid-cols-1 md:grid-cols-[280px_1fr] gap-12 items-start">
                <slot name="sidebar" />
                <main class="min-w-0 pt-0 text-justify">
                    <slot />
                </main>
            </div>
            
            <div class="mt-16">
                 <slot name="bottom" />
            </div>
            
            <footer class="mt-20 pt-8 border-t border-border text-center text-sm text-muted">
                <p>&copy; {new Date().getFullYear()} Gauransh Kumar. Built with Astro.</p>
            </footer>
        </div>
	</body>
</html>
