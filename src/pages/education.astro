---
import Layout from '../layouts/Layout.astro';
import Sidebar from '../components/Sidebar.astro';
---

<Layout title="Education - Gauransh Kumar">
    <Sidebar slot="sidebar" />
    
    <section class="max-w-2xl">
        <h1 class="font-serif text-3xl font-bold mb-8 text-foreground">Education</h1>
        
        <div class="space-y-10">
            <div class="relative pl-8 border-l border-border">
                <div class="absolute -left-1.5 top-1.5 w-3 h-3 rounded-full bg-border ring-4 ring-background"></div>
                <h3 class="text-lg font-semibold text-foreground">University of Montreal</h3>
                <div class="text-muted text-sm mb-2">2025 – Present</div>
                <p class="text-sm text-foreground/80 mb-1">Ph.D. in Computer Science</p>
            </div>

            <div class="relative pl-8 border-l border-border">
                <div class="absolute -left-1.5 top-1.5 w-3 h-3 rounded-full bg-border ring-4 ring-background"></div>
                <h3 class="text-lg font-semibold text-foreground">University of Montreal</h3>
                <div class="text-muted text-sm mb-2">2023 – 2025</div>
                <p class="text-sm text-foreground/80 mb-1">M.Sc. in Software Engineering (NLP)</p>
                <div class="text-sm text-muted">
                    <p>GPA: 3.925 / 4.3</p>
                </div>
            </div>

            <div class="relative pl-8 border-l border-border">
                 <div class="absolute -left-1.5 top-1.5 w-3 h-3 rounded-full bg-border ring-4 ring-background"></div>
                <h3 class="text-lg font-semibold text-foreground">Maharaja Agrasen Institute Of Technology</h3>
                <div class="text-muted text-sm mb-2">2020 – 2023</div>
                <p class="text-sm text-foreground/80 mb-1">B.Tech. in Computer Science and Engineering</p>
                <div class="text-sm text-muted">
                    <p>GPA: 9.0 / 10</p>
                </div>
            </div>
        </div>

        <h2 class="font-serif text-2xl font-bold mt-12 mb-6 text-foreground">Certifications</h2>
        <ul class="list-disc pl-5 space-y-2 text-muted">
            <li>Certified Kubernetes Application Developer (CKAD)</li>
            <li>Google Cloud Certified Cloud Digital Leader</li>
        </ul>
    </section>
</Layout>
