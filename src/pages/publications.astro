---
import Layout from '../layouts/Layout.astro';
import Sidebar from '../components/Sidebar.astro';
import { publications } from '../content/publications';
import PaperItem from '../components/PaperItem.astro';

---

<Layout title="Publications | Gauransh Kumar">
    <Sidebar slot="sidebar" />
    
    <section class="pt-0">
        <h1 class="font-serif text-3xl mb-6 text-foreground">Publications</h1>
        
        <p class="text-muted mb-6 leading-relaxed max-w-3xl">
            I primarily publish in Software Engineering and AI venues.
        </p>
        
        <ul class="space-y-0">
            {publications.map(paper => (
                <PaperItem 
                    title={paper.title} 
                    authors={paper.authors}
                    venue={paper.venue}
                    url={paper.url}
                    award={paper.award}
                    tags={paper.tags}
                />
            ))}
        </ul>
    </section>
</Layout>
