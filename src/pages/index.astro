---
import Layout from '../layouts/Layout.astro';
import Sidebar from '../components/Sidebar.astro';
import { publications } from '../content/publications';
import PaperItem from '../components/PaperItem.astro';
import { getEntry, render } from 'astro:content';

const aboutEntry = await getEntry('pages', 'about');
const { Content: AboutContent } = aboutEntry ? await render(aboutEntry) : { Content: null };
---

<Layout title="Gauransh Kumar">
    <Sidebar slot="sidebar" />
    
    {AboutContent && (
        <section class="space-y-6">
                <div class="prose prose-zinc dark:prose-invert max-w-none text-muted leading-relaxed">
                <AboutContent />
                </div>
        </section>
    )}



    <section slot="bottom" class="pt-12">
        <h2 class="font-serif text-2xl mb-4 text-foreground">Publications</h2>
        
        <p class="text-muted mb-6 leading-relaxed max-w-3xl">
            I primarily publish in Software Engineering and AI venues. 
        </p>
        <ul class="space-y-0">
            {publications.map(paper => (
                <PaperItem 
                    title={paper.title} 
                    authors={paper.authors}
                    venue={paper.venue}
                    url={paper.url}
                    award={paper.award}
                    tags={paper.tags}
                />
            ))}
        </ul>
    </section>
</Layout>
